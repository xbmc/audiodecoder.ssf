msgctxt "#30000"
msgid "Default length"
msgstr "Zadana dužina"

msgctxt "#30001"
msgid "Used if specified file does not provide the length."
msgstr "Koristi se ako navedena datoteka ne daje dužinu."

msgctxt "#30002"
msgid "unused"
msgstr "nekorišten"

msgctxt "#30003"
msgid "{0:d} s"
msgstr "{0:d} s"

msgctxt "#30004"
msgid "Default fade out time"
msgstr "Zadano vrijeme postepenog zatamnjenja"

msgctxt "#30005"
msgid "Used if specified file does not provide the length and fade."
msgstr "Koristi se ako navedena datoteka ne daje dužinu i fade."

msgctxt "#30006"
msgid "unused"
msgstr "nekorišten"

msgctxt "#30007"
msgid "{0:d} ms"
msgstr "{0:d} ms"

msgctxt "#30008"
msgid "Suppress opening silence"
msgstr "Potiskivanje početne tišine"

msgctxt "#30009"
msgid "Some files start with silent data, this prevents it and looks for the beginning."
msgstr "Neke datoteke počinju s tihim podacima, ovo to sprječava i traži početak."

msgctxt "#30010"
msgid "Suppress end silence"
msgstr "Potiskivanje krajnje tišine"

msgctxt "#30011"
msgid "Some files end with silent data, this prevents it and looks for the end."
msgstr "Neke datoteke završavaju tihim podacima, ovo to sprečava i traži kraj."

msgctxt "#30012"
msgid "Second of silence to check"
msgstr "Sekunda tišine za provjeru"

msgctxt "#30013"
msgid "How many silent seconds are allowed before playback is stopped."
msgstr "Koliko sekundi tišine je dozvoljeno prije zaustavljanja reprodukcije."

msgctxt "#30014"
msgid "{0:d} s"
msgstr "{0:d} s"

msgctxt "#30015"
msgid "Direct output"
msgstr "Direktni izlaz"

msgctxt "#30016"
msgid "Enable direct (dry) output."
msgstr "Omogućite direktni (suhi) izlaz."

msgctxt "#30017"
msgid "DSP emulation"
msgstr "Emulacija DSP-a"

msgctxt "#30018"
msgid "Enable DSP emulation (for reverb, etc.)."
msgstr "Omogućite DSP emulaciju (za reverb, itd.)."

msgctxt "#30019"
msgid "Dynamic recompiler"
msgstr "Dinamički rekompajler"

msgctxt "#30020"
msgid "Emulate DSP using dynamic recompiler."
msgstr "Emulirajte DSP koristeći dinamički rekompilator."
